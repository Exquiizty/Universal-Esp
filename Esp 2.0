local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TS = game:GetService("TweenService")
local RS = game:GetService("RunService")

local LP = Players.LocalPlayer

local rgb = Color3.fromRGB
local udim = UDim2.new
local offset = UDim2.fromOffset

local white = Color3.new(1, 1, 1)
local inkCol = rgb(30, 30, 36)
local bgCol = rgb(255, 255, 255)
local lineCol = rgb(210, 210, 218)
local accent = rgb(149, 92, 215)
local offCol = rgb(205, 205, 212)

local cartoon = Enum.Font.FredokaOne
local fast = TweenInfo.new(0.15)
local popTi = TweenInfo.new(
	0.3,
	Enum.EasingStyle.Quint,
	Enum.EasingDirection.Out
)

-- ESP COLORS
local espColor = rgb(255, 0, 0)

-- Visibility colors
local visibleColor = rgb(0, 255, 0)
local hiddenColor = rgb(255, 0, 0)

-- States
local isOn = false
local hlOn = true

local isOpen = true
local curTab = "main"

local espData = {}
local playerConns = {}

local addConn
local remConn
local teamConn
local visibilityConn
local visibilityTimer = 0
local VISIBILITY_INTERVAL = 0.12
local moveConn
local endConn

local onMove
local held

--==================================================
-- DRAGGING
--==================================================

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch
end

local function startDrag(i, fn)
	held = i

	onMove = function(m)
		if m == i or m.UserInputType == Enum.UserInputType.MouseMovement then
			fn(m)
		end
	end
end

moveConn = UIS.InputChanged:Connect(function(m)
	if onMove
		and (
			m.UserInputType == Enum.UserInputType.MouseMovement
			or m.UserInputType == Enum.UserInputType.Touch
		)
	then
		onMove(m)
	end
end)

endConn = UIS.InputEnded:Connect(function(i)
	if held
		and (
			i == held
			or (
				i.UserInputType == Enum.UserInputType.MouseButton1
				and held.UserInputType == Enum.UserInputType.MouseButton1
			)
		)
	then
		onMove = nil
		held = nil
	end
end)

--==================================================
-- UI HELPERS
--==================================================

local function make(class, props, par)
	local o = Instance.new(class)

	for k, val in props do
		o[k] = val
	end

	o.Parent = par
	return o
end

local function corner(o, a, b)
	make("UICorner", {
		CornerRadius = UDim.new(a, b or 0)
	}, o)
end

local function stroke(o, c, t, tr)
	return make("UIStroke", {
		Color = c,
		Thickness = t or 1,
		Transparency = tr or 0
	}, o)
end

local function makeToggle(par, pos)
	local b = make("TextButton", {
		AnchorPoint = Vector2.new(0, 0.5),
		Size = offset(44, 22),
		Position = pos,
		BackgroundColor3 = offCol,
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0
	}, par)

	local k = make("Frame", {
		Size = offset(16, 16),
		Position = udim(0, 3, 0.5, -8),
		BackgroundColor3 = white,
		BorderSizePixel = 0
	}, b)

	corner(b, 1)
	corner(k, 1)

	return b, k
end

local function skin(b, k, state, instant)
	local col = state and accent or offCol
	local pos = state
		and udim(1, -19, 0.5, -8)
		or udim(0, 3, 0.5, -8)

	if instant then
		b.BackgroundColor3 = col
		k.Position = pos
	else
		TS:Create(b, fast, {
			BackgroundColor3 = col
		}):Play()

		TS:Create(k, fast, {
			Position = pos
		}):Play()
	end
end

local function rowLabel(par, txt, pos)
	return make("TextLabel", {
		AnchorPoint = Vector2.new(0, 0.5),
		Size = offset(110, 22),
		Position = pos,
		BackgroundTransparency = 1,
		Text = txt,
		Font = cartoon,
		TextSize = 14,
		TextColor3 = rgb(50, 50, 58),
		TextXAlignment = Enum.TextXAlignment.Left
	}, par)
end


local moveConn = UIS.InputChanged:Connect(function(m)
	if onMove and (
		m.UserInputType == Enum.UserInputType.MouseMovement
		or m.UserInputType == Enum.UserInputType.Touch
	) then
		onMove(m)
	end
end)

local endConn = UIS.InputEnded:Connect(function(i)
	if held and (
		i == held
		or (
			i.UserInputType == Enum.UserInputType.MouseButton1
			and held.UserInputType == Enum.UserInputType.MouseButton1
		)
	) then
		onMove, held = nil, nil
	end
end)

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch
end

local function startDrag(i, fn)
	held = i

	onMove = function(m)
		if m == i or m.UserInputType == Enum.UserInputType.MouseMovement then
			fn(m)
		end
	end
end

local function make(class, props, par)
	local o = Instance.new(class)

	for k, val in props do
		o[k] = val
	end

	o.Parent = par
	return o
end

local function corner(o, a, b)
	make("UICorner", {
		CornerRadius = UDim.new(a, b or 0)
	}, o)
end

local function stroke(o, c, t, tr)
	return make("UIStroke", {
		Color = c,
		Thickness = t or 1,
		Transparency = tr or 0
	}, o)
end

local function makeToggle(par, pos)
	local b = make("TextButton", {
		AnchorPoint = Vector2.new(0, 0.5),
		Size = offset(44, 22),
		Position = pos,
		BackgroundColor3 = offCol,
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0
	}, par)

	local k = make("Frame", {
		Size = offset(16, 16),
		Position = udim(0, 3, 0.5, -8),
		BackgroundColor3 = white,
		BorderSizePixel = 0
	}, b)

	corner(b, 1)
	corner(k, 1)

	return b, k
end

local function skin(b, k, state, instant)
	local col = state and accent or offCol
	local pos = state
		and udim(1, -19, 0.5, -8)
		or udim(0, 3, 0.5, -8)

	if instant then
		b.BackgroundColor3 = col
		k.Position = pos
	else
		TS:Create(b, fast, {
			BackgroundColor3 = col
		}):Play()

		TS:Create(k, fast, {
			Position = pos
		}):Play()
	end
end

local function rowLabel(par, txt, pos)
	return make("TextLabel", {
		AnchorPoint = Vector2.new(0, 0.5),
		Size = offset(80, 22),
		Position = pos,
		BackgroundTransparency = 1,
		Text = txt,
		Font = cartoon,
		TextSize = 14,
		TextColor3 = rgb(50, 50, 58),
		TextXAlignment = Enum.TextXAlignment.Left
	}, par)
end

local function makeKnob(par, z, col)
	local k = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = offset(16, 16),
		BackgroundColor3 = col,
		BorderSizePixel = 0,
		ZIndex = z
	}, par)

	corner(k, 1)
	stroke(k, inkCol, 2.5)

	return k
end

local function colorFor(player)
	if teamOn and player.Team ~= LP.Team then
		return teamColor
	end

	return espColor
end

local function teamText(player)
	return player.Team and player.Team.Name or "No team"
end


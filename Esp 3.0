end)

--==================================================
-- MINIMIZE / CLOSE
--==================================================

minimizeBtn.Activated:Connect(function()

	isOpen = not isOpen

	content.Visible = isOpen

	closePickers()

	TS:Create(frame, fast, {
		Size =
			isOpen
			and offset(
				190,
				sizes[curTab]
			)
			or offset(190, 30)
	}):Play()
end)

closeBtn.Activated:Connect(function()

	isOn = false

	refresh()

	closePickers()

	if visibilityConn then
		visibilityConn:Disconnect()
		visibilityConn = nil
	end

	if lpTeamConn then
		lpTeamConn:Disconnect()
	end

	moveConn:Disconnect()
	endConn:Disconnect()

	gui:Destroy()
	tracerGui:Destroy()
end)


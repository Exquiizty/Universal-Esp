	welcome:Destroy()

	frame.Visible = true
end)

--==================================================
-- DRAGGING
--==================================================

head.InputBegan:Connect(function(i)

	if not isPress(i) then
		return
	end

	local start = i.Position
	local sp = frame.Position
	local dragged = false

	startDrag(i, function(m)

		local d =
			m.Position - start

		if not dragged
			and d.Magnitude >= 8 then

			dragged = true
		end

		if dragged then

			frame.Position = udim(
				sp.X.Scale,
				sp.X.Offset + d.X,
				sp.Y.Scale,
				sp.Y.Offset + d.Y
			)
		end
	end)
end)

local function closePickers()
	for _, p in pickers do
		p.close()
	end
end

woahj = function()
	for player, d in espData do
		local c = colorFor(player)

		if d.tag then
			d.tag.TextColor3 = c
		end

		if d.teamTag then
			d.teamTag.TextColor3 = c
		end

		if d.boxStroke then
			d.boxStroke.Color = c
		end

		if d.line then
			d.line.BackgroundColor3 = c
		end
	end
end

-- Checks whether there is a clear line of sight
-- from the camera to the player.
local function isPlayerVisible(player, d)
	if not d or not d.char or not d.char.Parent then
		return false
	end

	local camera = workspace.CurrentCamera

	if not camera then
		return false
	end

	local target = d.hd

	if not target or not target.Parent then
		target = d.root
	end

	if not target or not target.Parent then
		return false
	end

	local origin = camera.CFrame.Position
	local direction = target.Position - origin

	if direction.Magnitude <= 0 then
		return true
	end

	local params = RaycastParams.new()

	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {
		LP.Character
	}

	params.IgnoreWater = true

	local result = workspace:Raycast(
		origin,
		direction,
		params
	)

	if not result then
		return true
	end

	if result.Instance:IsDescendantOf(d.char) then
		return true
	end

	return false
end

--==================================================
-- HIGHLIGHT VISIBILITY
--
-- PACT + visible = GREEN
-- PACT + blocked = RED
-- NON-PACT = NO HIGHLIGHT
--==================================================

local function updateHighlightVisibility()
	if not isOn or not hlOn then
		return
	end

	for player, d in espData do

		local isPACT =
			player.Team
			and player.Team.Name == TARGET_TEAM

		-- Non-PACT players should never have a highlight
		if not isPACT then

			if d.hl then
				d.hl:Destroy()
				d.hl = nil
			end

			continue
		end

		-- Make sure PACT players have a highlight
		if not d.hl
			and d.char
			and d.char.Parent then

			d.hl = make("Highlight", {
				Adornee = d.char,
				FillColor = hiddenColor,
				OutlineColor = hiddenColor,
				FillTransparency = 0.5,
				DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			}, idkFolder)
		end

		if d.hl then
			local visible = isPlayerVisible(player, d)

			if visible then
				d.hl.FillColor = visibleColor
				d.hl.OutlineColor = visibleColor
			else
				d.hl.FillColor = hiddenColor
				d.hl.OutlineColor = hiddenColor
			end
		end
	end
end

lpTeamConn = LP:GetPropertyChangedSignal("Team"):Connect(function()
	woahj()
end)

local function paintTab(b, active)
	TS:Create(b, fast, {
		BackgroundColor3 = active and accent or rgb(238, 238, 243),
		TextColor3 = active and white or rgb(90, 90, 100)
	}):Play()
end

local function showTab(name)
	curTab = name

	mainBody.Visible = name == "main"
	setBody.Visible = name == "settings"

	closePickers()

	paintTab(tabMain, name == "main")
	paintTab(tabSet, name == "settings")

	if isOpen then
		TS:Create(frame, fast, {
			Size = offset(190, sizes[name])
		}):Play()
	end
end

local function clearEsp(player)
	local d = espData[player]

	if d then
		for _, k in pieceKeys do
			if d[k] then
				d[k]:Destroy()
			end
		end

		espData[player] = nil
	end
end

--==================================================
-- CREATE / UPDATE ESP
--==================================================

local function sync(player)
	local d = espData[player]

	if not d then
		return
	end

	local c = colorFor(player)

	-- ONLY PACT GETS HIGHLIGHT
	local isPACT =
		player.Team
		and player.Team.Name == TARGET_TEAM

	if isOn and hlOn and isPACT then

		if not d.hl then
			d.hl = make("Highlight", {
				Adornee = d.char,
				FillColor = hiddenColor,
				OutlineColor = hiddenColor,
				FillTransparency = 0.5,
				DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			}, idkFolder)
		end

	elseif d.hl then

		d.hl:Destroy()
		d.hl = nil

	end

	-- USERNAME / TEAM NAME
	local key =
		(isOn and unOn and 1 or 0)
		+
		(isOn and tnOn and 2 or 0)

	if key ~= d.key and (key == 0 or d.hd) then

		if d.bb then
			d.bb:Destroy()
			d.bb, d.tag, d.teamTag = nil, nil, nil
		end

		d.key = key

		if key > 0 then

			local both = key == 3

			d.bb = make("BillboardGui", {
				Adornee = d.hd,
				Size = offset(120, both and 40 or 20),
				StudsOffset = Vector3.new(
					0,
					both and 3 or 2.5,
					0
				),
				AlwaysOnTop = true
			}, idkFolder)

			if key >= 2 then
				d.teamTag = make("TextLabel", {
					Size = udim(1, 0, 0, 20),
					BackgroundTransparency = 1,
					Text = teamText(player),
					Font = cartoon,
					TextSize = 13,
					TextColor3 = c,
					TextStrokeTransparency = 0.4
				}, d.bb)
			end

			if key % 2 == 1 then
				d.tag = make("TextLabel", {
					Size = udim(1, 0, 0, 20),
					Position = offset(
						0,
						both and 20 or 0
					),
					BackgroundTransparency = 1,
					Text = player.DisplayName,
					Font = cartoon,
					TextSize = 14,
					TextColor3 = c,
					TextStrokeTransparency = 0.4
				}, d.bb)
			end
		end
	end

	-- BOX
	if isOn and boxOn then

		if d.root and not d.boxGui then

			d.boxGui = make("BillboardGui", {
				Adornee = d.root,
				Size = UDim2.new(4.5, 0, 6, 0),
				AlwaysOnTop = true
			}, idkFolder)

			d.boxStroke = stroke(
				make("Frame", {
					Size = UDim2.fromScale(1, 1),
					BackgroundTransparency = 1
				}, d.boxGui),
				c,
				1.5
			)
		end

	elseif d.boxGui then

		d.boxGui:Destroy()
		d.boxGui, d.boxStroke = nil, nil

	end

	-- TRACERS
	if isOn and tracerOn then

		if d.root and not d.line then

			d.line = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = offset(2, 0),
				BackgroundColor3 = c,
				BorderSizePixel = 0,
				Visible = false
			}, tracerGui)
		end

	elseif d.line then

		d.line:Destroy()
		d.line, d.px, d.py = nil, nil, nil

	end
end

local function setup(player, char)
	clearEsp(player)

	local d = {
		char = char
	}

	espData[player] = d

	sync(player)

	d.root = char:WaitForChild(
		"HumanoidRootPart",
		5
	)

	d.hd = char:WaitForChild(
		"Head",
		5
	)

	if espData[player] == d then
		sync(player)
	end
end

local function dropConns(player)
	local t = woahjConns[player]

	if t then
		for _, c in t do
			c:Disconnect()
		end

		woahjConns[player] = nil
	end
end

local function trackPlayer(player)
	if player == LP then
		return
	end

	woahjConns[player] = {

		player.CharacterAdded:Connect(function(char)
			setup(player, char)
		end),

		player:GetPropertyChangedSignal("Team"):Connect(function()

			local d = espData[player]

			if d and d.teamTag then
				d.teamTag.Text = teamText(player)
			end

			-- Immediately update PACT highlight
			sync(player)

			woahj()
			updateHighlightVisibility()
		end)
	}

	if player.Character then
		task.spawn(
			setup,
			player,
			player.Character
		)
	end
end

--==================================================
-- TRACER UPDATE
--==================================================

local function updateLines()
	local cam = workspace.CurrentCamera

	if not cam then
		return
	end

	local vs = cam.ViewportSize

	local ax, ay =
		vs.X / 2,
		vs.Y

	for _, d in espData do

		local line = d.line

		if line then

			local rt = d.root
			local show = false

			if rt and rt.Parent then

				local p =
					cam:WorldToViewportPoint(
						rt.Position
					)

				if p.Z > 0 then

					show = true

					if d.px ~= p.X
						or d.py ~= p.Y then

						d.px, d.py =
							p.X,
							p.Y

						local dx =
							p.X - ax

						local dy =
							p.Y - ay

						line.Position = offset(
							ax + dx / 2,
							ay + dy / 2
						)

						line.Size = offset(
							2,
							math.sqrt(
								dx * dx
								+
								dy * dy
							)
						)

						line.Rotation =
							math.deg(
								math.atan2(
									dy,
									dx
								)
							) - 90
					end

				else
					d.px = nil
				end
			end

			if line.Visible ~= show then
				line.Visible = show
			end
		end
	end
end

--==================================================
-- REFRESH
--==================================================

local function refresh()

	if isOn then

		if addConn then

			for player in espData do
				sync(player)
			end

		else

			for _, player in Players:GetPlayers() do
				trackPlayer(player)
			end

			addConn =
				Players.PlayerAdded:Connect(
					trackPlayer
				)

			remConn =
				Players.PlayerRemoving:Connect(
					function(player)
						dropConns(player)
						clearEsp(player)
					end
				)
		end

	elseif addConn then

		addConn:Disconnect()
		remConn:Disconnect()

		addConn, remConn = nil, nil

		for player in woahjConns do
			dropConns(player)
		end

		for player in espData do
			clearEsp(player)
		end
	end

	-- TRACERS
	if isOn
		and tracerOn
		and not lineConn then

		lineConn =
			RS.RenderStepped:Connect(
				updateLines
			)

	elseif not (isOn and tracerOn)
		and lineConn then

		lineConn:Disconnect()
		lineConn = nil
	end

	-- HIGHLIGHT VISIBILITY
	if isOn
		and hlOn
		and not visibilityConn then

		visibilityConn =
			RS.RenderStepped:Connect(
				updateHighlightVisibility
			)

	elseif not (isOn and hlOn)
		and visibilityConn then

		visibilityConn:Disconnect()
		visibilityConn = nil
	end

	-- Immediately update highlights
	if isOn and hlOn then
		updateHighlightVisibility()
	end
end


local function makePicker(par, pos, startColor, onChange)
	local api = {}
	local h, s, v = startColor:ToHSV()
	local color = startColor
	local open, queued = false, false

	local swatch = make("TextButton", {
		AnchorPoint = Vector2.new(0, 0.5),
		Size = offset(26, 26),
		Position = pos,
		BackgroundColor3 = color,
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0
	}, par)

	local pop = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Size = offset(190, 196),
		Position = udim(0.5, 0, 1, 6),
		BackgroundColor3 = bgCol,
		BorderSizePixel = 0,
		Visible = false
	}, frame)

	local popBase = stroke(pop, rgb(225, 225, 232), 2)
	local popStroke = stroke(pop, white, 2)

	local popGrad = make("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.25, 0.5),
			NumberSequenceKeypoint.new(0.48, 0),
			NumberSequenceKeypoint.new(0.5, 1),
			NumberSequenceKeypoint.new(0.75, 0.5),
			NumberSequenceKeypoint.new(0.98, 0),
			NumberSequenceKeypoint.new(1, 1)
		})
	}, popStroke)

	local popScale = make("UIScale", {}, pop)

	local svBox = make("Frame", {
		Size = offset(170, 96),
		Position = offset(10, 10),
		BackgroundColor3 = white,
		BorderSizePixel = 0,
		Active = true
	}, pop)

	local svGrad = make("UIGradient", {}, svBox)

	local darkOverlay = make("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		ZIndex = 2
	}, svBox)

	local hueSlider = make("Frame", {
		Size = offset(170, 20),
		Position = offset(10, 112),
		BackgroundTransparency = 1,
		Active = true
	}, pop)

	local hueBar = make("Frame", {
		Size = udim(1, 0, 0, 10),
		Position = udim(0, 0, 0.5, -5),
		BackgroundColor3 = white,
		BorderSizePixel = 0
	}, hueSlider)

	local previewDot = make("Frame", {
		Size = offset(24, 24),
		Position = offset(10, 162),
		BackgroundColor3 = color,
		BorderSizePixel = 0
	}, pop)

	local rgbInput = make("TextBox", {
		Size = offset(130, 24),
		Position = offset(50, 162),
		BackgroundColor3 = rgb(238, 238, 243),
		BorderSizePixel = 0,
		Font = cartoon,
		TextSize = 13,
		TextColor3 = inkCol,
		PlaceholderText = "255, 0, 0",
		PlaceholderColor3 = rgb(150, 150, 160),
		ClearTextOnFocus = false,
		Text = "255, 0, 0"
	}, pop)

	local svKnob, hueKnob =
		makeKnob(svBox, 3, color),
		makeKnob(hueSlider, 2, color)

	local inputStroke = stroke(rgbInput, lineCol, 1.5)

	local spinTween = TS:Create(
		popGrad,
		TweenInfo.new(
			2,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.In,
			-1
		),
		{
			Rotation = 360
		}
	)

	make("UIGradient", {
		Transparency = NumberSequence.new(1, 0),
		Rotation = 90
	}, darkOverlay)

	make("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, rgb(255, 0, 0)),
			ColorSequenceKeypoint.new(1 / 6, rgb(255, 255, 0)),
			ColorSequenceKeypoint.new(2 / 6, rgb(0, 255, 0)),
			ColorSequenceKeypoint.new(3 / 6, rgb(0, 255, 255)),
			ColorSequenceKeypoint.new(4 / 6, rgb(0, 0, 255)),
			ColorSequenceKeypoint.new(5 / 6, rgb(255, 0, 255)),
			ColorSequenceKeypoint.new(1, rgb(255, 0, 0))
		})
	}, hueBar)

	corner(swatch, 0, 8)
	stroke(swatch, inkCol, 1.5, 0.6)
	corner(pop, 0, 12)
	corner(svBox, 0, 8)
	corner(darkOverlay, 0, 8)
	corner(hueBar, 1)
	corner(previewDot, 1)
	stroke(previewDot, inkCol, 1, 0.6)
	corner(rgbInput, 0, 8)

	local function paint()
		color = Color3.fromHSV(h, s, v)

		swatch.BackgroundColor3 = color
		previewDot.BackgroundColor3 = color
		svKnob.BackgroundColor3 = color
		hueKnob.BackgroundColor3 = Color3.fromHSV(h, 1, 1)

		svGrad.Color = ColorSequence.new(
			white,
			Color3.fromHSV(h, 1, 1)
		)

		popGrad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, accent),
			ColorSequenceKeypoint.new(0.48, color),
			ColorSequenceKeypoint.new(0.5, accent),
			ColorSequenceKeypoint.new(0.98, color),
			ColorSequenceKeypoint.new(1, accent)
		})

		svKnob.Position = UDim2.fromScale(s, 1 - v)
		hueKnob.Position = UDim2.fromScale(h, 0.5)

		rgbInput.Text = string.format(
			"%d, %d, %d",
			math.round(color.R * 255),
			math.round(color.G * 255),
			math.round(color.B * 255)
		)
	end

	local function changed()
		if queued then
			return
		end

		queued = true

		task.defer(function()
			queued = false
			paint()
			onChange(color)
		end)
	end

	for i, c in presetColors do
		local chip = make("TextButton", {
			Size = offset(16, 16),
			Position = offset(10 + (i - 1) * 22, 138),
			BackgroundColor3 = c,
			Text = "",
			AutoButtonColor = false,
			BorderSizePixel = 0
		}, pop)

		corner(chip, 1)
		stroke(chip, inkCol, 1, 0.6)

		chip.Activated:Connect(function()
			h, s, v = c:ToHSV()
			changed()
		end)
	end

	local function idk(i, name)
		if name == "sv" then
			s = math.clamp(
				(i.Position.X - svBox.AbsolutePosition.X)
					/ svBox.AbsoluteSize.X,
				0,
				1
			)

			v = 1 - math.clamp(
				(i.Position.Y - svBox.AbsolutePosition.Y)
					/ svBox.AbsoluteSize.Y,
				0,
				1
			)
		else
			h = math.clamp(
				(i.Position.X - hueSlider.AbsolutePosition.X)
					/ hueSlider.AbsoluteSize.X,
				0,
				0.999
			)
		end

		changed()
	end

	local function bindSlider(fr, name)
		fr.InputBegan:Connect(function(i)
			if not isPress(i) then
				return
			end

			idk(i, name)

			startDrag(i, function(m)
				idk(m, name)
			end)
		end)
	end

	bindSlider(svBox, "sv")
	bindSlider(hueSlider, "hue")

	rgbInput.Focused:Connect(function()
		TS:Create(inputStroke, fast, {
			Color = accent
		}):Play()
	end)

	rgbInput.FocusLost:Connect(function()
		TS:Create(inputStroke, fast, {
			Color = lineCol
		}):Play()

		local r, g, b = rgbInput.Text:match(
			"(%d+)%D+(%d+)%D+(%d+)"
		)

		if r then
			h, s, v = rgb(
				math.clamp(tonumber(r), 0, 255),
				math.clamp(tonumber(g), 0, 255),
				math.clamp(tonumber(b), 0, 255)
			):ToHSV()
		end

		changed()
	end)

	local function WHAT(state)
		open = state

		if state then
			for _, p in pickers do
				if p ~= api then
					p.close()
				end
			end

			pop.Visible = true
			popScale.Scale = 0.9
			pop.Position = udim(0.5, 0, 1, -4)
			popStroke.Transparency = 1
			popBase.Transparency = 1
			popGrad.Rotation = 0

			TS:Create(popScale, popTi, {
				Scale = 1
			}):Play()

			TS:Create(pop, popTi, {
				Position = udim(0.5, 0, 1, 6)
			}):Play()

			TS:Create(popStroke, popTi, {
				Transparency = 0
			}):Play()

			TS:Create(popBase, popTi, {
				Transparency = 0
			}):Play()

			spinTween:Play()
		else
			pop.Visible = false
			spinTween:Cancel()
		end
	end

	swatch.Activated:Connect(function()
		WHAT(not open)
	end)

	api.close = function()
		WHAT(false)
	end

	table.insert(pickers, api)

	paint()

	return api
end

